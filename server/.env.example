# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_token_here
OPENCLAW_AGENT_ID=voice

# Voice backend: local or openai_realtime
# local = local Whisper -> OpenClaw -> ElevenLabs/OpenAI TTS
# openai_realtime = OpenAI speech-to-speech with OpenClaw exposed as a tool
VOICE_BACKEND=local

# OpenAI (required for VOICE_BACKEND=openai_realtime, optional TTS fallback for local)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_INTERRUPT_RESPONSE=true
OPENAI_REALTIME_IDLE_TIMEOUT_SECONDS=120
OPENAI_REALTIME_TIMEOUT_SECONDS=60
VOICE_CONTEXT_SEED_PATH=voice_context_seed.json
VOICE_CONTEXT_GENERATED_PATH=~/.openclaw/runtime/rey-voice/voice_context_hints.generated.json
VOICE_CONTEXT_REFRESH_SECONDS=86400
VOICE_CONTEXT_REFRESH_TIMEOUT_SECONDS=20
VOICE_CONTEXT_MAX_HINTS=10

# Wake Word
WAKE_WORD=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# Whisper Model (tiny.en, base.en, small.en, medium.en)
WHISPER_MODEL=base.en

# TTS Model
TTS_MODEL=en_US-lessac-medium

# Server
HOST=0.0.0.0
PORT=8765

# Authentication - REQUIRED for security!
# Generate with: openssl rand -hex 24
AUTH_TOKEN=your_auth_token_here
# Optional: requester origin metadata for durable delegated-task completions
OPENCLAW_DELIVERY_CHANNEL=
OPENCLAW_DELIVERY_TO=
OPENCLAW_DELIVERY_ACCOUNT_ID=
OPENCLAW_DELIVERY_THREAD_ID=
# Optional: route durable/project voice work through this canonical OpenClaw session instead of the ephemeral voice session.
# If unset, Discord channel delivery targets resolve to agent:main:discord:<OPENCLAW_DELIVERY_TO>.
OPENCLAW_AUTHORITATIVE_AGENT_ID=main
OPENCLAW_AUTHORITATIVE_SESSION_KEY=
# Optional JSON override for named voice routing targets. Built-in defaults include humanslivehere, tenpace, and rey-voice.
OPENCLAW_ROUTE_TARGETS_JSON=
